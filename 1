        // 4. Memory Gallery File System (Local-First Memory Reader)
        let customImages = JSON.parse(localStorage.getItem('amour_custom_images')) || [];

        function handleLocalFiles(event) {
            const files = event.target.files;
            if (!files) return;

            Array.from(files).forEach(file => {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const imgObj = {
                        id: Date.now() + Math.random(),
                        url: e.target.result,
                        caption: file.name.substring(0, file.name.lastIndexOf('.')) || "Our beautiful memory"
                    };
                    customImages.push(imgObj);
                    // Prevent memory overflow on LocalStorage base64 limits
                    if (customImages.length > 9) {
                        customImages.shift(); // keep last 9 items
                    }
                    localStorage.setItem('amour_custom_images', JSON.stringify(customImages));
                    renderGallery();
                }
                reader.readAsDataURL(file);
            });
            showToast("Images loaded successfully!", "success");
        }

