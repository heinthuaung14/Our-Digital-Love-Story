import { useState, useEffect } from "react";
import { Card, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Textarea } from "@/components/ui/textarea";
import { motion } from "framer-motion";

export default function AmourProApp() {
  const [notes, setNotes] = useState([]);
  const [text, setText] = useState("");
  const [photos, setPhotos] = useState([]);

  // Anniversary state
  const [time, setTime] = useState({ years: 0, months: 0, days: 0, seconds: "00" });
  const [daysToNext, setDaysToNext] = useState(0);
  const [celebrate, setCelebrate] = useState(false);
  // Load data
  useEffect(() => {
    const savedNotes = JSON.parse(localStorage.getItem("amour_notes")) || [];
    const savedPhotos = JSON.parse(localStorage.getItem("amour_photos")) || [];
    setNotes(savedNotes);
    setPhotos(savedPhotos);
  }, []);

  // Anniversary logic
  useEffect(() => {
    const start = new Date("2013-02-14");

    const update = () => {
      const now = new Date();

      // precise time
      let years = now.getFullYear() - start.getFullYear();
      let months = now.getMonth() - start.getMonth();
      let days = now.getDate() - start.getDate();
      if (days < 0) {
        months--;
        const lastMonth = new Date(now.getFullYear(), now.getMonth(), 0);
        days += lastMonth.getDate();
      }
      if (months < 0) {
        years--;
        months += 12;
      }
      // next anniversary
      let next = new Date(start);
      next.setFullYear(now.getFullYear());
      if (now > next) next.setFullYear(now.getFullYear() + 1);
      const diff = Math.ceil((next - now) / (1000 * 60 * 60 * 24));
      setDaysToNext(diff);
      // celebration trigger
      if (diff === 0) {
        setCelebrate(true);
      }


      setTime({
        years,
        months,
        days,
        seconds: now.getSeconds().toString().padStart(2, "0"),
      });
    };


    update();
    const interval = setInterval(update, 1000);

    return () => clearInterval(interval);
  }, []);

  // Save notes
  const addNote = () => {
    if (!text.trim()) return;
    const newNotes = [
      { id: Date.now(), text, date: new Date().toLocaleDateString() },
      ...notes,
    ];
    setNotes(newNotes);
    localStorage.setItem("amour_notes", JSON.stringify(newNotes));
    setText("");
  };

  // Upload photo
  const uploadPhoto = (e) => {
    const file = e.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = () => {
      const newPhotos = [
        { id: Date.now(), url: reader.result },
        ...photos,
      ];
      setPhotos(newPhotos);
      localStorage.setItem("amour_photos", JSON.stringify(newPhotos));
    };
    reader.readAsDataURL(file);
  };

  return (
    <div className="min-h-screen bg-black text-white p-6 grid gap-6 relative overflow-hidden">
      {/* Celebration animation */}
      {celebrate && (
        <motion.div
          className="absolute inset-0 flex items-center justify-center bg-black/70 z-50"
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
        >
          <motion.div
            className="text-center"
            initial={{ scale: 0.5 }}
            animate={{ scale: 1.2 }}
          >
            <h1 className="text-5xl font-bold text-pink-400">🎉 Happy Anniversary ❤️</h1>
            <p className="text-lg text-gray-300 mt-2">Forever with you...</p>
          </motion.div>
        </motion.div>
      )}


      {/* Header */}
      <motion.h1
        initial={{ opacity: 0, y: 20 }}
        animate={{ opacity: 1, y: 0 }}
        className="text-3xl font-bold text-pink-400"
      >
        ❤️ Amour Pro Edition
      </motion.h1>

      {/* Anniversary Counter */}
      <Card className="bg-zinc-900 rounded-2xl border border-pink-600/20">
        <CardContent className="p-4 text-center">
          <h2 className="text-lg font-semibold text-pink-300">⏳ Our Love Timer</h2>


          <div className="grid grid-cols-4 gap-3 mt-4">
            <div>
              <p className="text-2xl font-bold text-pink-400">{time.years}</p>
              <p className="text-xs text-gray-500">Years</p>
            </div>
            <div>
              <p className="text-2xl font-bold text-pink-400">{time.months}</p>
              <p className="text-xs text-gray-500">Months</p>
            </div>
            <div>
              <p className="text-2xl font-bold text-pink-400">{time.days}</p>
              <p className="text-xs text-gray-500">Days</p>
            </div>
            <div>
              <p className="text-xl font-mono text-yellow-400">{time.seconds}</p>
              <p className="text-xs text-gray-500">Sec</p>
            </div>
          </div>


          <p className="mt-4 text-sm text-pink-300">⏰ {daysToNext} days until next anniversary</p>
        </CardContent>
      </Card>

      {/* Love Stats */}
      <Card className="bg-zinc-900 rounded-2xl">
        <CardContent className="p-4 grid grid-cols-3 text-center">
          <div>
            <p className="text-xl font-bold">{notes.length}</p>
            <p className="text-xs text-gray-400">Notes</p>
          </div>
          <div>
            <p className="text-xl font-bold">{photos.length}</p>
            <p className="text-xs text-gray-400">Photos</p>
          </div>
          <div>
            <p className="text-xl font-bold">∞</p>
            <p className="text-xs text-gray-400">Love</p>
          </div>
        </CardContent>
      </Card>

      {/* Notes */}
      <Card className="bg-zinc-900 rounded-2xl">
        <CardContent className="p-4">
          <h2 className="text-lg font-semibold mb-2">💌 Love Notes</h2>
          <Textarea
            placeholder="Write something sweet..."
            value={text}
            onChange={(e) => setText(e.target.value)}
          />
          <Button onClick={addNote} className="mt-2 w-full">
            Save Note
          </Button>

          <div className="mt-4 space-y-2">
            {notes.map((n) => (
              <div key={n.id} className="bg-black p-2 rounded">
                <p>{n.text}</p>
                <span className="text-xs text-gray-500">{n.date}</span>
              </div>
            ))}
          </div>
        </CardContent>
      </Card>

      {/* Gallery */}
      <Card className="bg-zinc-900 rounded-2xl">
        <CardContent className="p-4">
          <h2 className="text-lg font-semibold mb-2">📸 Memory Gallery</h2>
          <Input type="file" onChange={uploadPhoto} />

          <div className="grid grid-cols-2 gap-2 mt-4">
            {photos.map((p) => (
              <img
                key={p.id}
                src={p.url}
                className="rounded-xl object-cover h-32 w-full"
              />
            ))}
          </div>
        </CardContent>
      </Card>
    </div>
  );
}
