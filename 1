        // 3. Audio Ambient Radio Desk Controls
        let playPromise = null;

        function safePlay(audio) {
            playPromise = audio.play();
            if (playPromise !== undefined) {
                playPromise.catch(error => {
                    // Gracefully intercept and absorb play-pause interruptions or Autoplay security blocks
                    if (error.name !== "AbortError") {
                        console.warn("Audio play promise exception handled safely:", error);
                    }
                });
            }
        }

        function safePause(audio) {
            if (playPromise !== null) {
                playPromise.then(() => {
                    audio.pause();
                }).catch(() => {
                    audio.pause();
                });
            } else {
                audio.pause();
            }
        }

        function toggleMusicPlayback() {
            const audio = document.getElementById('ambient-audio');
            const playBtn = document.getElementById('music-play-btn');
            const musicIcon = document.getElementById('music-icon');
            const musicStatus = document.getElementById('music-status');

            if (audio.paused) {
                safePlay(audio);
                musicIcon.setAttribute('data-lucide', 'pause');
                musicStatus.innerText = "Playing peaceful melody loops...";
                showToast("Background radio playing softly...", "love");
            } else {
                safePause(audio);
                musicIcon.setAttribute('data-lucide', 'play');
                musicStatus.innerText = "Radio stream paused.";
            }
            lucide.createIcons();
        }

        // Track list changer
        function changeTrack(theme) {
