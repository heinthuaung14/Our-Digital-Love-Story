<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Amour: Our Digital Love Scrapbook</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        rose: {
                            50: '#fff1f2',
                            100: '#ffe4e6',
                            200: '#fecdd3',
                            500: '#f43f5e',
                            600: '#e11d48',
                            700: '#be123c',
                            900: '#881337',
                        },
                        amber: {
                            400: '#fbbf24',
                            500: '#f59e0b',
                            600: '#d97706',
                        },
                        dark: {
                            900: '#0b0610',
                            800: '#140c1c',
                            700: '#231530',
                            600: '#352147',
                        }
                    },
                    fontFamily: {
                        sans: ['Playfair Display', 'Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace']
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap');
        
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0b0610;
            overflow-x: hidden;
        }

        h1, h2, h3, .serif-font {
            font-family: 'Playfair Display', serif;
        }

        .heart-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
        }

        .glass-panel {
            background: rgba(20, 12, 28, 0.7);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(244, 63, 94, 0.15);
        }

        .glass-card {
            background: rgba(35, 21, 48, 0.45);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.04);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-card:hover {
            border-color: rgba(244, 63, 94, 0.3);
            transform: translateY(-2px);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0b0610;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(244, 63, 94, 0.3);
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(244, 63, 94, 0.6);
        }
    </style>
</head>
<body class="text-slate-100 flex flex-col min-h-screen relative selection:bg-rose-500/30">

    <!-- Interactive Heart Canvas Background -->
    <canvas id="heart-canvas" class="heart-canvas"></canvas>

    <!-- Global Toast Container -->
    <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- Top Navigation Header -->
    <header class="glass-panel sticky top-0 z-40 px-6 py-4 flex items-center justify-between border-b border-rose-950/40">
        <div class="flex items-center gap-3">
            <div class="bg-gradient-to-tr from-rose-600 to-amber-500 p-2.5 rounded-full shadow-lg shadow-rose-500/20">
                <i data-lucide="heart" class="w-5 h-5 text-white animate-pulse"></i>
            </div>
            <div>
                <h1 class="text-xl font-bold tracking-tight bg-gradient-to-r from-rose-100 via-rose-300 to-amber-200 bg-clip-text text-transparent">AMOUR</h1>
                <p class="text-[10px] text-rose-300/70 font-semibold tracking-wider uppercase">Our Digital Love Story</p>
            </div>
        </div>

        <!-- Right System Controls -->
        <div class="flex items-center gap-4 z-50">
            <!-- Dynamic Counter Shortcode -->
            <div class="hidden md:flex items-center gap-1 bg-rose-950/40 px-3 py-1.5 rounded-full border border-rose-500/20 text-xs">
                <span class="w-1.5 h-1.5 rounded-full bg-rose-500 animate-ping"></span>
                <span id="header-counter-days" class="font-bold text-rose-300">Calculating...</span>
            </div>
            <!-- Theme Changer / Customize -->
            <button onclick="toggleThemeModal()" class="p-2 rounded-xl bg-dark-800 hover:bg-dark-700 border border-slate-800 transition">
                <i data-lucide="sparkles" class="w-4 h-4 text-amber-400"></i>
            </button>
        </div>
    </header>

    <!-- Theme Customization Modal -->
    <div id="theme-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="glass-panel max-w-md w-full p-6 rounded-2xl relative">
            <button onclick="toggleThemeModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
            <h3 class="text-lg font-bold mb-1 flex items-center gap-2 text-rose-400">
                <i data-lucide="palette" class="w-5 h-5"></i>
                Personalize Your Space
            </h3>
            <p class="text-xs text-slate-400 mb-4">Set the background ambiance and theme to perfectly fit your couple's aesthetic.</p>
            
            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Ambiance Theme</label>
                    <div class="grid grid-cols-2 gap-2">
                        <button onclick="applyTheme('crimson')" class="bg-rose-950/40 border border-rose-500/30 p-2.5 rounded-xl text-left text-xs hover:bg-rose-900/30 transition">
                            <p class="font-bold text-rose-300">Crimson Romance</p>
                            <p class="text-[9px] text-slate-400">Deep burgundy & soft pinks</p>
                        </button>
                        <button onclick="applyTheme('burmese-gold')" class="bg-amber-950/40 border border-amber-500/30 p-2.5 rounded-xl text-left text-xs hover:bg-amber-900/30 transition">
                            <p class="font-bold text-amber-300">Golden Pagoda</p>
                            <p class="text-[9px] text-slate-400">Glimmering gold & royal amber</p>
                        </button>
                        <button onclick="applyTheme('emerald')" class="bg-emerald-950/40 border border-emerald-500/30 p-2.5 rounded-xl text-left text-xs hover:bg-emerald-900/30 transition">
                            <p class="font-bold text-emerald-300">Emerald Meadows</p>
                            <p class="text-[9px] text-slate-400">Lush greens & warm teal</p>
                        </button>
                        <button onclick="applyTheme('cyber')" class="bg-indigo-950/40 border border-indigo-500/30 p-2.5 rounded-xl text-left text-xs hover:bg-indigo-900/30 transition">
                            <p class="font-bold text-indigo-300">Neon Hearts</p>
                            <p class="text-[9px] text-slate-400">Vaporwave neon & purple clouds</p>
                        </button>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Anniversary Celebration Date</label>
                    <input type="date" id="anniversary-date-input" value="2013-02-14" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-sm text-slate-200 focus:outline-none focus:border-rose-500 font-mono">
                </div>
                <button onclick="saveThemeSettings()" class="w-full bg-gradient-to-r from-rose-600 to-amber-500 hover:from-rose-500 hover:to-amber-400 text-white text-sm font-bold p-3 rounded-xl transition duration-200">
                    Apply & Save Memories
                </button>
            </div>
        </div>
    </div>

    <!-- Main Workspace -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-4 lg:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6 relative z-10">
        
        <!-- Left Sidebar: Anniversary Counter & Music Desk -->
        <aside class="lg:col-span-4 space-y-6">
            
            <!-- Love Clock (Anniversary Live Tracker) -->
            <div class="glass-panel p-5 rounded-3xl border border-rose-500/20 relative overflow-hidden">
                <div class="absolute -right-10 -bottom-10 opacity-10">
                    <i data-lucide="clock" class="w-36 h-36 text-rose-500"></i>
                </div>
                <div class="flex items-center justify-between mb-4">
                    <span class="text-xs font-bold uppercase tracking-wider text-rose-400">Our Time Together</span>
                    <i data-lucide="infinity" class="w-4 h-4 text-amber-400"></i>
                </div>
                
                <p class="text-xs text-slate-400">Since our magical day on <strong id="clock-anniversary-display" class="text-slate-200 font-serif">February 14, 2013</strong>:</p>
                
                <!-- Live Counter Stats -->
                <div class="grid grid-cols-2 gap-3 mt-4">
                    <div class="bg-dark-800/60 p-3 rounded-2xl border border-rose-950/30 text-center">
                        <p id="counter-years" class="text-2xl font-black text-rose-300">0</p>
                        <p class="text-[10px] uppercase font-bold text-slate-500">Years</p>
                    </div>
                    <div class="bg-dark-800/60 p-3 rounded-2xl border border-rose-950/30 text-center">
                        <p id="counter-months" class="text-2xl font-black text-rose-300">0</p>
                        <p class="text-[10px] uppercase font-bold text-slate-500">Months</p>
                    </div>
                    <div class="bg-dark-800/60 p-3 rounded-2xl border border-rose-950/30 text-center">
                        <p id="counter-days" class="text-2xl font-black text-rose-300">0</p>
                        <p class="text-[10px] uppercase font-bold text-slate-500">Days</p>
                    </div>
                    <div class="bg-dark-800/60 p-3 rounded-2xl border border-rose-950/30 text-center">
                        <p id="counter-seconds" class="text-lg font-mono font-bold text-amber-400">00</p>
                        <p class="text-[10px] uppercase font-bold text-slate-500">Seconds</p>
                    </div>
                </div>

                <!-- Custom Goal Milestones -->
                <div class="mt-4 pt-3 border-t border-rose-950/30 flex items-center justify-between text-xs text-slate-400">
                    <span>Next Milestone Countdown:</span>
                    <span id="countdown-to-next" class="font-bold text-rose-400">000 Days</span>
                </div>
            </div>

            <!-- Cozy Lo-Fi Radio Desk -->
            <div class="glass-panel p-5 rounded-3xl border border-rose-500/20">
                <span class="text-xs font-bold uppercase tracking-wider text-rose-400 block mb-3">Our Cozy Radio</span>
                <div class="flex items-center gap-4">
                    <button onclick="toggleMusicPlayback()" id="music-play-btn" class="bg-gradient-to-tr from-rose-600 to-rose-700 hover:from-rose-500 hover:to-rose-600 text-white p-3.5 rounded-full shadow-lg transition duration-150">
                        <i data-lucide="play" id="music-icon" class="w-5 h-5"></i>
                    </button>
                    <div class="flex-1">
                        <h4 class="text-xs font-bold text-slate-200">Midnight Serenade</h4>
                        <p id="music-status" class="text-[10px] text-slate-500">Stream paused. Turn on background music.</p>
                    </div>
                </div>

                <!-- Hidden HTML5 Audio Element utilizing beautiful ambient piano loops -->
                <audio id="ambient-audio" loop>
                    <source src="https://assets.mixkit.co/music/preview/mixkit-beautiful-dream-dreamy-piano-and-strings-1002.mp3" type="audio/mp3">
                </audio>

                <div class="grid grid-cols-3 gap-1.5 mt-4">
                    <button onclick="changeTrack('dreamy')" class="text-[10px] font-semibold bg-dark-800 hover:bg-dark-700 p-2 rounded-lg border border-slate-800 text-slate-300">Dreamy Piano</button>
                    <button onclick="changeTrack('sunset')" class="text-[10px] font-semibold bg-dark-800 hover:bg-dark-700 p-2 rounded-lg border border-slate-800 text-slate-300">Sunset Chill</button>
                    <button onclick="changeTrack('stars')" class="text-[10px] font-semibold bg-dark-800 hover:bg-dark-700 p-2 rounded-lg border border-slate-800 text-slate-300">Lofi Stars</button>
                </div>
            </div>

            <!-- Couple Quiz Space (Playful Compatibility) -->
            <div class="glass-panel p-5 rounded-3xl border border-rose-500/20">
                <span class="text-xs font-bold uppercase tracking-wider text-rose-400 block mb-2">Playful Love Quiz</span>
                <p class="text-[11px] text-slate-400 mb-4">How well do you know each other? Answer this together!</p>
                
                <div id="quiz-container" class="space-y-3">
                    <div class="bg-dark-800/80 p-3 rounded-xl border border-slate-800">
                        <p id="quiz-question" class="text-xs font-semibold text-slate-200">Where did we celebrate our first traditional Burmese milestone together?</p>
                        <div class="grid grid-cols-2 gap-2 mt-3">
                            <button onclick="submitAnswer(false)" class="text-[10px] font-bold bg-dark-900 hover:bg-rose-950/20 p-2 rounded border border-rose-950 text-slate-300">In Mandalay</button>
                            <button onclick="submitAnswer(true)" class="text-[10px] font-bold bg-dark-900 hover:bg-rose-950/20 p-2 rounded border border-rose-950 text-slate-300">In Yangon</button>
                        </div>
                    </div>
                </div>
            </div>

        </aside>

        <!-- Right Core Area: Milestones, Gallery & Notes -->
        <div class="lg:col-span-8 space-y-6">

            <!-- Interactive Timeline Map -->
            <div class="glass-panel p-6 rounded-3xl border border-rose-500/20">
                <div class="flex items-center justify-between border-b border-rose-950/40 pb-4 mb-6">
                    <div class="flex items-center gap-2">
                        <i data-lucide="map-pin" class="w-5 h-5 text-rose-400"></i>
                        <h2 class="text-lg font-bold">Our Love Story Milestones</h2>
                    </div>
                    <button onclick="addNewMilestonePrompt()" class="flex items-center gap-1 bg-rose-600 hover:bg-rose-500 text-white text-xs font-bold px-3 py-1.5 rounded-full shadow transition">
                        <i data-lucide="plus" class="w-3.5 h-3.5"></i> Add Milestone
                    </button>
                </div>

                <!-- Custom Interactive Timeline Node Tree -->
                <div class="relative pl-6 border-l border-rose-500/30 space-y-8" id="timeline-nodes">
                    
                    <!-- Preconfigured Milestones corresponding to user photos -->
                    <div class="relative timeline-item" id="milestone-wedding">
                        <span class="absolute -left-[31px] top-1 bg-amber-500 border-4 border-[#0b0610] w-4 h-4 rounded-full animate-pulse"></span>
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <span class="text-[10px] font-bold font-mono text-amber-400 bg-amber-950/40 px-2 py-0.5 rounded border border-amber-900/40 uppercase">Feb 11, 2017</span>
                            <div class="flex gap-1">
                                <button onclick="deleteMilestone('milestone-wedding')" class="text-slate-500 hover:text-red-400 p-1 transition"><i data-lucide="trash-2" class="w-3.5 h-3.5"></i></button>
                            </div>
                        </div>
                        <h3 class="text-sm font-bold text-amber-200 mt-1">The Golden Ceremony</h3>
                        <p class="text-xs text-slate-300 mt-1 leading-relaxed">Walking hand-in-hand celebrating our love in exquisite, matching traditional golden Burmese wedding attire. This day marks our eternal promise.</p>
                        <div class="mt-2.5 flex flex-wrap gap-1.5">
                            <span class="text-[9px] bg-rose-500/10 text-rose-300 px-2 py-0.5 rounded-full border border-rose-500/20">Ceremony</span>
                            <span class="text-[9px] bg-amber-500/10 text-amber-300 px-2 py-0.5 rounded-full border border-amber-500/20">Traditional</span>
                            <span class="text-[9px] bg-slate-800 text-slate-300 px-2 py-0.5 rounded-full">Burmese Attire</span>
                        </div>
                    </div>

                    <div class="relative timeline-item" id="milestone-couch">
                        <span class="absolute -left-[31px] top-1 bg-rose-500 border-4 border-[#0b0610] w-4 h-4 rounded-full"></span>
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <span class="text-[10px] font-bold font-mono text-rose-400 bg-rose-950/40 px-2 py-0.5 rounded border border-rose-900/40 uppercase">Jun 11, 2017</span>
                            <div class="flex gap-1">
                                <button onclick="deleteMilestone('milestone-couch')" class="text-slate-500 hover:text-red-400 p-1 transition"><i data-lucide="trash-2" class="w-3.5 h-3.5"></i></button>
                            </div>
                        </div>
                        <h3 class="text-sm font-bold text-slate-200 mt-1">Quiet Afternoons Together</h3>
                        <p class="text-xs text-slate-300 mt-1 leading-relaxed">Cozy moments relaxing at home, taking warm selfies, and enjoying the simple, perfect peace of being alongside each other.</p>
                        <div class="mt-2.5 flex flex-wrap gap-1.5">
                            <span class="text-[9px] bg-rose-500/10 text-rose-300 px-2 py-0.5 rounded-full border border-rose-500/20">Home Sweet Home</span>
                            <span class="text-[9px] bg-slate-800 text-slate-300 px-2 py-0.5 rounded-full">Casual</span>
                        </div>
                    </div>

                    <div class="relative timeline-item" id="milestone-pagoda">
                        <span class="absolute -left-[31px] top-1 bg-amber-500 border-4 border-[#0b0610] w-4 h-4 rounded-full"></span>
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <span class="text-[10px] font-bold font-mono text-amber-400 bg-amber-950/40 px-2 py-0.5 rounded border border-rose-900/40 uppercase">Sep 2017</span>
                            <div class="flex gap-1">
                                <button onclick="deleteMilestone('milestone-pagoda')" class="text-slate-500 hover:text-red-400 p-1 transition"><i data-lucide="trash-2" class="w-3.5 h-3.5"></i></button>
                            </div>
                        </div>
                        <h3 class="text-sm font-bold text-amber-200 mt-1">Blessings at the Pagoda</h3>
                        <p class="text-xs text-slate-300 mt-1 leading-relaxed">Visiting the spectacular golden pagoda. Dressed in red, holding hands, making wishes, and sharing smiles in front of sacred architecture.</p>
                        <div class="mt-2.5 flex flex-wrap gap-1.5">
                            <span class="text-[9px] bg-rose-500/10 text-rose-300 px-2 py-0.5 rounded-full border border-rose-500/20">Pagoda Visit</span>
                            <span class="text-[9px] bg-amber-500/10 text-amber-300 px-2 py-0.5 rounded-full border border-amber-500/20">Yangon</span>
                            <span class="text-[9px] bg-slate-800 text-slate-300 px-2 py-0.5 rounded-full">Blessings</span>
                        </div>
                    </div>

                    <div class="relative timeline-item" id="milestone-newyear">
                        <span class="absolute -left-[31px] top-1 bg-rose-500 border-4 border-[#0b0610] w-4 h-4 rounded-full"></span>
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <span class="text-[10px] font-bold font-mono text-rose-400 bg-rose-950/40 px-2 py-0.5 rounded border border-rose-900/40 uppercase">Jan 2, 2018</span>
                            <div class="flex gap-1">
                                <button onclick="deleteMilestone('milestone-newyear')" class="text-slate-500 hover:text-red-400 p-1 transition"><i data-lucide="trash-2" class="w-3.5 h-3.5"></i></button>
                            </div>
                        </div>
                        <h3 class="text-sm font-bold text-slate-200 mt-1">Yangon Sunsets & Sweet Kisses</h3>
                        <p class="text-xs text-slate-300 mt-1 leading-relaxed">Playful, sunny days at 29°C in Yangon! Capturing cute selfie collages, sharing kisses on the cheek, and dreaming about our beautiful future.</p>
                        <div class="mt-2.5 flex flex-wrap gap-1.5">
                            <span class="text-[9px] bg-rose-500/10 text-rose-300 px-2 py-0.5 rounded-full border border-rose-500/20">New Year</span>
                            <span class="text-[9px] bg-slate-800 text-slate-300 px-2 py-0.5 rounded-full">Kisses</span>
                            <span class="text-[9px] bg-slate-800 text-slate-300 px-2 py-0.5 rounded-full">29°C Warmth</span>
                        </div>
                    </div>

                    <div class="relative timeline-item" id="milestone-dinner">
                        <span class="absolute -left-[31px] top-1 bg-rose-500 border-4 border-[#0b0610] w-4 h-4 rounded-full"></span>
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <span class="text-[10px] font-bold font-mono text-rose-400 bg-rose-950/40 px-2 py-0.5 rounded border border-rose-900/40 uppercase">Apr 22, 2018</span>
                            <div class="flex gap-1">
                                <button onclick="deleteMilestone('milestone-dinner')" class="text-slate-500 hover:text-red-400 p-1 transition"><i data-lucide="trash-2" class="w-3.5 h-3.5"></i></button>
                            </div>
                        </div>
                        <h3 class="text-sm font-bold text-slate-200 mt-1">Anniversary Dinner Date</h3>
                        <p class="text-xs text-slate-300 mt-1 leading-relaxed">A romantic dinner outdoors sharing a warm barbecue and hotpot, celebrating milestones under the cozy lights.</p>
                        <div class="mt-2.5 flex flex-wrap gap-1.5">
                            <span class="text-[9px] bg-rose-500/10 text-rose-300 px-2 py-0.5 rounded-full border border-rose-500/20">Dinner Date</span>
                            <span class="text-[9px] bg-slate-800 text-slate-300 px-2 py-0.5 rounded-full">Cozy Nights</span>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Dynamic Memory Vault: Multi-Upload Gallery -->
            <div class="glass-panel p-6 rounded-3xl border border-rose-500/20">
                <div class="flex flex-wrap items-center justify-between gap-4 border-b border-rose-950/40 pb-4 mb-4">
                    <div>
                        <h2 class="text-lg font-bold flex items-center gap-2">
                            <i data-lucide="image" class="text-rose-400"></i> Our Memory Gallery Vault
                        </h2>
                        <p class="text-[11px] text-slate-400">Upload and tag photos from your device to preserve them in your vault.</p>
                    </div>

                    <!-- local file dropper button -->
                    <div>
                        <label class="cursor-pointer bg-gradient-to-tr from-rose-600 to-rose-700 hover:from-rose-500 hover:to-rose-600 text-white font-bold text-xs px-4 py-2 rounded-xl transition duration-150 inline-flex items-center gap-1.5 shadow-lg shadow-rose-600/10">
                            <i data-lucide="upload-cloud" class="w-4 h-4"></i>
                            Upload Photos
                            <input type="file" id="photo-uploader" class="hidden" multiple accept="image/*" onchange="handleLocalFiles(event)">
                        </label>
                    </div>
                </div>

                <!-- Custom Grid Vault -->
                <div id="gallery-grid" class="grid grid-cols-2 md:grid-cols-3 gap-4">
                    <!-- Standard Beautiful Handcrafted Placeholder Cards with instructions -->
                    <div class="relative group bg-slate-900 rounded-2xl overflow-hidden aspect-square flex flex-col items-center justify-center border border-dashed border-rose-950 text-center p-4">
                        <i data-lucide="heart-handshake" class="w-8 h-8 text-rose-500/30 mb-2"></i>
                        <span class="text-xs font-bold text-slate-400">Our Photo Here</span>
                        <p class="text-[10px] text-slate-500 mt-1">Upload the matching pictures you shared with me to save them here locally.</p>
                    </div>
                </div>
            </div>

            <!-- Private Love Diary / Message Desk -->
            <div class="glass-panel p-6 rounded-3xl border border-rose-500/20">
                <div class="flex items-center justify-between border-b border-rose-950/40 pb-3 mb-4">
                    <h2 class="text-lg font-bold flex items-center gap-2">
                        <i data-lucide="pen-tool" class="text-rose-400"></i> Our Daily Diary & Wishes
                    </h2>
                    <span class="text-[10px] font-mono font-bold text-slate-400 bg-dark-800 px-2 py-1 rounded">Private Local Journal</span>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1">Add a New Message, Promise or Wish</label>
