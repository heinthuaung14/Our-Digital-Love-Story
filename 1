        // 9. Floating Heart Dynamic Background Animation Canvas
        function initHearts() {
            const canvas = document.getElementById('heart-canvas');
            const ctx = canvas.getContext('2d');
            
            let width = canvas.width = window.innerWidth;
            let height = canvas.height = window.innerHeight;

            window.addEventListener('resize', () => {
                width = canvas.width = window.innerWidth;
                height = canvas.height = window.innerHeight;
            });

            const hearts = [];
            const colors = ['rgba(244, 63, 94, 0.2)', 'rgba(217, 119, 6, 0.12)', 'rgba(236, 72, 153, 0.15)'];

            class Heart {
                constructor() {
                    this.reset();
                    this.y = Math.random() * height;
                }

                reset() {
                    this.x = Math.random() * width;
                    this.y = height + 10;
                    this.size = Math.random() * 8 + 4;
                    this.speed = Math.random() * 0.5 + 0.3;
                    this.opacity = Math.random() * 0.5 + 0.3;
                    this.color = colors[Math.floor(Math.random() * colors.length)];
                    this.swing = Math.random() * 2;
                    this.swingSpeed = Math.random() * 0.01 + 0.005;
                    this.time = Math.random() * 100;
                }

                update() {
                    this.y -= this.speed;
                    this.time += this.swingSpeed;
                    this.x += Math.sin(this.time) * 0.2;

                    if (this.y < -10) {
                        this.reset();
                    }
                }

                draw() {
                    ctx.save();
                    ctx.globalAlpha = this.opacity;
                    ctx.fillStyle = this.color;
                    ctx.beginPath();
                    
                    // Draw classical vector heart shape
                    const d = this.size;
                    const x = this.x;
                    const y = this.y;
                    
                    ctx.moveTo(x, y + d / 4);
                    ctx.quadraticCurveTo(x, y, x + d / 2, y);
                    ctx.quadraticCurveTo(x + d, y, x + d, y + d / 3);
                    ctx.quadraticCurveTo(x + d, y + d * 2/3, x + d/2, y + d * 1.1);
                    ctx.quadraticCurveTo(x, y + d * 2/3, x, y + d/3);
                    
                    ctx.fill();
                    ctx.restore();
                }
            }

            for (let i = 0; i < 40; i++) {
                hearts.push(new Heart());
            }

            function animate() {
                ctx.clearRect(0, 0, width, height);
                hearts.forEach(heart => {
                    heart.update();
                    heart.draw();
                });
                requestAnimationFrame(animate);
            }

            // Start animation loop
            animate();
        }
    </script>
</body>
</html>
