    <script>
        // Couple's Config Data with Persistent Syncing
        let baseAnniversary = localStorage.getItem('amour_anniversary') || '2013-02-14';
        let currentTheme = localStorage.getItem('amour_theme') || 'crimson';
        let activeJournalMood = '🥰';

        // Pre-configured custom default notes for relationship history
        const defaultNotes = [
            { id: 1, text: "Always remember walking down the aisle in matching Burmese gold. Let's keep making beautiful promises.", mood: "💍", date: "Feb 11, 2017" },
            { id: 2, text: "Loving you is the sweetest adventure. Happy moments in Yangon!", mood: "🥰", date: "Jan 02, 2018" }
        ];

        // Core Initialization on DOM Load
        document.addEventListener("DOMContentLoaded", () => {
            lucide.createIcons();
            initHearts();
            applyTheme(currentTheme);
            
            // Set input default date
            document.getElementById('anniversary-date-input').value = baseAnniversary;
            
            // Calculate love timeline clocks immediately
            startTimelineClock();
            setInterval(startTimelineClock, 1000);

            // Render existing notes & custom gallery loaded locally
            loadCustomNotes();
            renderGallery();
        });

        // 1. Anniversary Clock Calculations
        function startTimelineClock() {
            const startDate = new Date(baseAnniversary);
            const now = new Date();
            
            let diffMs = now - startDate;
            if (diffMs < 0) {
                // Future anniversary edge case protection
                diffMs = 0;
            }

            const totalDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
            
            // Precise Date Math
            let years = now.getFullYear() - startDate.getFullYear();
            let months = now.getMonth() - startDate.getMonth();
            let days = now.getDate() - startDate.getDate();

            if (days < 0) {
                months--;
                const lastMonth = new Date(now.getFullYear(), now.getMonth(), 0);
                days += lastMonth.getDate();
            }
            if (months < 0) {
                years--;
                months += 12;
            }

            const secs = now.getSeconds().toString().padStart(2, '0');

            // Render
            document.getElementById('counter-years').innerText = years;
            document.getElementById('counter-months').innerText = months;
            document.getElementById('counter-days').innerText = days;
            document.getElementById('counter-seconds').innerText = secs;
            
            document.getElementById('header-counter-days').innerText = `${totalDays} Days of Love`;
            
            // Calculate Next Milestone (Next year anniversary)
            const currentYear = now.getFullYear();
            let nextAnniversary = new Date(baseAnniversary);
            nextAnniversary.setFullYear(currentYear);
            
            if (now > nextAnniversary) {
                nextAnniversary.setFullYear(currentYear + 1);
            }
            
            const daysToNext = Math.ceil((nextAnniversary - now) / (1000 * 60 * 60 * 24));
            document.getElementById('countdown-to-next').innerText = `${daysToNext} Days`;

            // Display top date format
            const formattedDate = startDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
            document.getElementById('clock-anniversary-display').innerText = formattedDate;
        }

        // 2. Modals Control & Config
        function toggleThemeModal() {
            const modal = document.getElementById('theme-modal');
            modal.classList.toggle('hidden');
        }

        function toggleMilestoneModal() {
            const modal = document.getElementById('milestone-modal');
            modal.classList.toggle('hidden');
        }

        function applyTheme(themeName) {
            currentTheme = themeName;
            document.documentElement.className = "dark";
            
            // Adjust body background color & borders
            const body = document.body;
            if (themeName === 'crimson') {
                body.style.background = 'radial-gradient(circle at top right, rgba(244, 63, 94, 0.15), transparent 45%), radial-gradient(circle at bottom left, rgba(136, 19, 55, 0.1), transparent 45%), #0c0610';
            } else if (themeName === 'burmese-gold') {
                body.style.background = 'radial-gradient(circle at top right, rgba(245, 158, 11, 0.15), transparent 45%), radial-gradient(circle at bottom left, rgba(217, 119, 6, 0.08), transparent 45%), #0c0a05';
            } else if (themeName === 'emerald') {
                body.style.background = 'radial-gradient(circle at top right, rgba(16, 185, 129, 0.12), transparent 45%), radial-gradient(circle at bottom left, rgba(4, 120, 87, 0.08), transparent 45%), #040c08';
